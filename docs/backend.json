
{
  "entities": {
    "Project": {
      "title": "Portfolio Project",
      "description": "A high-end design project showcase",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string", "enum": ["Residential", "Commercial"] },
        "location": { "type": "string" },
        "imageUrl": { "type": "string" },
        "description": { "type": "string" },
        "size": { "type": "string", "enum": ["small", "large"] },
        "order": { "type": "number" }
      },
      "required": ["title", "category", "location", "imageUrl"]
    },
    "ClientProject": {
      "title": "Ongoing Client Project",
      "description": "An active interior design or decor project for a specific client",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "planType": { "type": "string", "enum": ["Genesis", "Full Commission"] },
        "status": { "type": "string", "enum": ["Consultation", "Planning", "Procurement", "Execution", "Styling", "Completed", "Termination Pending", "Terminated"] },
        "progress": { "type": "number" },
        "description": { "type": "string" },
        "clientEmail": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "date": { "type": "string" },
              "isCompleted": { "type": "boolean" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "Inquiry": {
      "title": "Client Inquiry",
      "description": "A lead or project-specific support request",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "projectId": { "type": "string" },
        "type": { "type": "string", "enum": ["new_business", "project_support", "complaint", "termination_request"] },
        "serviceType": { "type": "string", "enum": ["design", "decor", "bundle"] },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "contacted", "closed"], "default": "new" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Feedback": {
      "title": "Client Feedback",
      "description": "Public testimonial from the feedback page",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "isApproved": { "type": "boolean", "default": false },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of portfolio projects"
    },
    "/client-projects/{clientProjectId}": {
      "schema": "ClientProject",
      "description": "Ongoing active client projects"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Client leads and project support requests"
    },
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "Client testimonials"
    }
  }
}
